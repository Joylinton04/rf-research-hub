# Public origin of the deployed site, with protocol and no trailing slash, e.g.
# https://antennagroupknust.com. Canonical URLs, sitemap.xml and robots.txt are
# all built from it at build time, so set it before the first production build —
# left unset, those files point at localhost and search engines ignore them.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback automatically.
NEXT_PUBLIC_SITE_URL=

# Neon Postgres connection string — use the POOLED endpoint (host contains -pooler)
DATABASE_URI=

# Signs auth tokens. Generated locally; keep out of git (.env is gitignored).
PAYLOAD_SECRET=

# Neon Object Storage (S3-compatible) — backs the Media collection.
# Create the bucket in the Neon Console, then read these off the credential it
# issues. Object Storage is beta and only in aws-us-east-2 / aws-eu-central-1,
# which is where the Postgres branch above already lives.
S3_BUCKET=media                # optional; the code already defaults to "media"
AWS_REGION=us-east-2
AWS_ENDPOINT_URL_S3=         # branch-specific S3 endpoint
AWS_ACCESS_KEY_ID=           # credential token_id
AWS_SECRET_ACCESS_KEY=       # credential s3_secret_access_key
